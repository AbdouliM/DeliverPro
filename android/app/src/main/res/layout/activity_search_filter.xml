<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/activity_search_filter.xml — Écran 05 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#FFFFFF"
        android:elevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recherche"
                android:textColor="#1A1A1A"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Filtrer les livraisons"
                android:textColor="#888888"
                android:textSize="12sp" />
        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Section PÉRIODE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PÉRIODE"
                android:textSize="11sp"
                android:textColor="#888888"
                android:letterSpacing="0.08"
                android:layout_marginBottom="10dp" />

            <!-- Dates début / fin -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Date de début"
                        android:textSize="12sp"
                        android:textColor="#888888"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvDateStart"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:text="Sélectionner"
                        android:textColor="#1A56A4"
                        android:background="@drawable/bg_input"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Date de fin"
                        android:textSize="12sp"
                        android:textColor="#888888"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvDateEnd"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:text="Sélectionner"
                        android:textColor="#1A56A4"
                        android:background="@drawable/bg_input"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>
            </LinearLayout>

            <!-- Raccourcis rapides -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/btnToday"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Aujourd'hui"
                    android:textSize="13sp"
                    android:textColor="#1A56A4"
                    android:background="@drawable/bg_chip_selected"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnThisWeek"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Cette semaine"
                    android:textSize="13sp"
                    android:textColor="#888888"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnThisMonth"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Ce mois"
                    android:textSize="13sp"
                    android:textColor="#888888"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Section FILTRES -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FILTRES"
                android:textSize="11sp"
                android:textColor="#888888"
                android:letterSpacing="0.08"
                android:layout_marginBottom="10dp" />

            <!-- Filtre Livreur -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Livreur"
                android:textSize="13sp"
                android:textColor="#444444"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/spinnerDeliverer"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_input"
                android:paddingStart="12dp"
                android:layout_marginBottom="16dp" />

            <!-- Filtre État -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="État de livraison"
                android:textSize="13sp"
                android:textColor="#444444"
                android:layout_marginBottom="8dp" />

            <!-- Chips statut -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <TextView android:id="@+id/chipAll"
                    android:layout_width="wrap_content" android:layout_height="36dp"
                    android:text="Tous" android:textSize="13sp" android:gravity="center"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:layout_marginEnd="8dp" android:clickable="true" android:focusable="true"
                    android:background="@drawable/bg_chip_selected" android:textColor="#1A56A4" />

                <TextView android:id="@+id/chipDelivered"
                    android:layout_width="wrap_content" android:layout_height="36dp"
                    android:text="Livré" android:textSize="13sp" android:gravity="center"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:layout_marginEnd="8dp" android:clickable="true" android:focusable="true"
                    android:background="@drawable/bg_chip" android:textColor="#888888" />

                <TextView android:id="@+id/chipPending"
                    android:layout_width="wrap_content" android:layout_height="36dp"
                    android:text="En attente" android:textSize="13sp" android:gravity="center"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:layout_marginEnd="8dp" android:clickable="true" android:focusable="true"
                    android:background="@drawable/bg_chip" android:textColor="#888888" />

                <TextView android:id="@+id/chipFailed"
                    android:layout_width="wrap_content" android:layout_height="36dp"
                    android:text="Échoué" android:textSize="13sp" android:gravity="center"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:clickable="true" android:focusable="true"
                    android:background="@drawable/bg_chip" android:textColor="#888888" />
            </LinearLayout>

            <!-- Recherche N° commande / client -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="N° commande / Client"
                android:textSize="13sp"
                android:textColor="#444444"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etSearchText"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Rechercher..."
                android:textColorHint="#BBBBBB"
                android:background="@drawable/bg_input"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textSize="14sp"
                android:inputType="text" />

        </LinearLayout>
    </ScrollView>

    <!-- Bouton Rechercher fixe en bas -->
    <Button
        android:id="@+id/btnSearch"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Rechercher"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#1A56A4"
        android:layout_margin="16dp" />

</LinearLayout>