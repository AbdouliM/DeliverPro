<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/activity_delivery_detail.xml — Écran 06 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#FFFFFF"
        android:elevation="2dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvOrderNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Détails livraison"
                    android:textSize="12sp"
                    android:textColor="#888888" />
            </LinearLayout>
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingEnd="8dp" />
        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="#FFFFFF" android:orientation="vertical"
                android:padding="16dp" android:layout_marginBottom="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="INFOS CLIENT" android:textSize="11sp" android:textColor="#888888"
                    android:letterSpacing="0.08" android:layout_marginBottom="10dp" />
                <TextView android:id="@+id/tvClientName" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textSize="17sp"
                    android:textStyle="bold" android:textColor="#1A1A1A" android:layout_marginBottom="6dp" />
                <TextView android:id="@+id/tvClientPhone" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#1A56A4" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="#FFFFFF" android:orientation="vertical"
                android:padding="16dp" android:layout_marginBottom="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="ADRESSE DE LIVRAISON" android:textSize="11sp" android:textColor="#888888"
                    android:letterSpacing="0.08" android:layout_marginBottom="10dp" />
                <View android:layout_width="match_parent" android:layout_height="120dp"
                    android:background="#E8F0F8" android:layout_marginBottom="10dp" />
                <TextView android:id="@+id/tvAddress" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textSize="14sp"
                    android:textColor="#1A1A1A" android:layout_marginBottom="8dp" />
                <TextView android:id="@+id/tvOpenMaps" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Voir sur Maps ↗"
                    android:textSize="13sp" android:textColor="#1A56A4"
                    android:clickable="true" android:focusable="true" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="#FFFFFF" android:orientation="vertical"
                android:padding="16dp" android:layout_marginBottom="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="INFOS COMMANDE" android:textSize="11sp" android:textColor="#888888"
                    android:letterSpacing="0.08" android:layout_marginBottom="12dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Montant" android:textColor="#888888" android:textSize="14sp" />
                    <TextView android:id="@+id/tvAmount" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="#1A1A1A"
                        android:textSize="14sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Paiement" android:textColor="#888888" android:textSize="14sp" />
                    <TextView android:id="@+id/tvPayment" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="#1A1A1A" android:textSize="14sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Livreur" android:textColor="#888888" android:textSize="14sp" />
                    <TextView android:id="@+id/tvDelivererName" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="#1A1A1A" android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/layoutFailureBanner"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="#FFF0F0" android:orientation="horizontal"
                android:padding="14dp" android:layout_marginBottom="12dp"
                android:visibility="gone" android:gravity="center_vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="▲ " android:textColor="#E53935" android:textSize="14sp" />
                <TextView android:id="@+id/tvFailureReason" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textColor="#E53935" android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="8dp">
                <Button android:id="@+id/btnCall" android:layout_width="0dp"
                    android:layout_height="48dp" android:layout_weight="1"
                    android:text="📞 Appeler" android:textColor="#1A56A4"
                    android:backgroundTint="#E8F0F8" android:layout_marginEnd="8dp" />
                <Button android:id="@+id/btnMessage" android:layout_width="0dp"
                    android:layout_height="48dp" android:layout_weight="1"
                    android:text="💬 Message" android:textColor="#1A56A4"
                    android:backgroundTint="#E8F0F8" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom nav — labelVisibilityMode fixes disappearing labels -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:menu="@menu/menu_controller_bottom"
        app:itemIconTint="@drawable/bottom_nav_selector"
        app:itemTextColor="@drawable/bottom_nav_selector"
        app:labelVisibilityMode="labeled" />

</LinearLayout>