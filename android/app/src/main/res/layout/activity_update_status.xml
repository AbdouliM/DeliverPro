<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/activity_update_status.xml — Écran 10 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#FFFFFF"
        android:elevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Modifier l'état"
                android:textColor="#1A1A1A"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDeliveryRef"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#888888" />
        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CHOISIR LE NOUVEL ÉTAT"
                android:textSize="11sp"
                android:textColor="#888888"
                android:letterSpacing="0.08"
                android:layout_marginBottom="12dp" />

            <!-- Option LIVRÉ -->
            <LinearLayout
                android:id="@+id/optionDelivered"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:background="@drawable/bg_option_default"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="✓"
                    android:textSize="18sp"
                    android:textColor="#43A047"
                    android:gravity="center"
                    android:background="@drawable/bg_icon_green"
                    android:layout_marginEnd="14dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Livré"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#1A1A1A" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Commande remise au client"
                        android:textSize="12sp"
                        android:textColor="#888888" />
                </LinearLayout>

                <RadioButton
                    android:id="@+id/radioDelivered"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

            <!-- Option EN ATTENTE -->
            <LinearLayout
                android:id="@+id/optionPending"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:background="@drawable/bg_option_default"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="⏰"
                    android:textSize="18sp"
                    android:gravity="center"
                    android:background="@drawable/bg_icon_orange"
                    android:layout_marginEnd="14dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="En attente"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#1A1A1A" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Livraison en cours de traitement"
                        android:textSize="12sp"
                        android:textColor="#888888" />
                </LinearLayout>

                <RadioButton
                    android:id="@+id/radioPending"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

            <!-- Option NON LIVRÉ -->
            <LinearLayout
                android:id="@+id/optionFailed"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:background="@drawable/bg_option_default"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="✕"
                    android:textSize="18sp"
                    android:textColor="#E53935"
                    android:gravity="center"
                    android:background="@drawable/bg_icon_red"
                    android:layout_marginEnd="14dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Non livré"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#1A1A1A" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Livraison à reprogrammer/Retour"
                        android:textSize="12sp"
                        android:textColor="#888888" />
                </LinearLayout>

                <RadioButton
                    android:id="@+id/radioFailed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

            <!-- Remarque (obligatoire si Non livré) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REMARQUE"
                android:textSize="11sp"
                android:textColor="#888888"
                android:letterSpacing="0.08"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvRemarkHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Obligatoire si Non livré"
                android:textSize="12sp"
                android:textColor="#E53935"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etRemark"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:hint="Saisir la raison (client absent, refus la commande, adresse introuvable...)"
                android:textColorHint="#BBBBBB"
                android:background="@drawable/bg_input"
                android:padding="12dp"
                android:textSize="14sp"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:layout_marginBottom="16dp" />

            <!-- Infos commande résumé -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INFORMATIONS COMMANDE"
                    android:textSize="11sp"
                    android:textColor="#888888"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="10dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="6dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="N° commande" android:textColor="#888888" android:textSize="13sp" />
                    <TextView android:id="@+id/tvOrderNumber" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="#1A56A4" android:textSize="13sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="6dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Client" android:textColor="#888888" android:textSize="13sp" />
                    <TextView android:id="@+id/tvClientName" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="#1A1A1A" android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="6dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Tél. client" android:textColor="#888888" android:textSize="13sp" />
                    <TextView android:id="@+id/tvClientPhone" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="#1A56A4" android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Montant" android:textColor="#888888" android:textSize="13sp" />
                    <TextView android:id="@+id/tvAmount" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="#1A1A1A" android:textSize="13sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Boutons Annuler / Confirmer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCancel"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="Annuler"
                    android:textColor="#888888"
                    android:backgroundTint="#EEEEEE"
                    android:layout_marginEnd="10dp" />

                <Button
                    android:id="@+id/btnConfirm"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="2"
                    android:text="Confirmer"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#1A56A4" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>